rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function confirmedConnection(userA, userB) {
      let connectionId = userA < userB
        ? userA + "_" + userB
        : userB + "_" + userA;
      return exists(/databases/$(database)/documents/connections/$(connectionId))
        && get(/databases/$(database)/documents/connections/$(connectionId)).data.status == "confirmed";
    }

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 280
        && request.resource.data.state is string
        && request.resource.data.state.size() <= 60;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /posts/{postId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorId
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.visibility in ["circle", "public"]
        && request.resource.data.state is string
        && request.resource.data.mediaURL is string
        && request.resource.data.mediaType in ["", "image"];
      allow read: if request.auth != null
        && (
          resource.data.authorId == request.auth.uid
          || (
            resource.data.visibility == "public"
            && resource.data.state == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.state
          )
          || (
            resource.data.visibility == "circle"
            && confirmedConnection(resource.data.authorId, request.auth.uid)
          )
        );
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.authorId;
    }

    match /connections/{connectionId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.status == "pending";
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.status in ["pending", "confirmed"];
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;
    }
  }
}
